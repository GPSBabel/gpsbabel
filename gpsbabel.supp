{
   <qt6_qhash_simd_unaligned_16_byte_read_fix>
#  This is intermittently triggered by vtesto -l text
#  This should not require dbgsyms.
#  Fedora 41 qt6-qtbase.x86_64 6.8.0-4.fc41
#  Fedora 40 qt6-qtbase.x86_64 6.7.2-6.fc40 intermittant
#  Ubuntu Jammy libqt6core6/jammy-updates,now 6.2.4+dfsg-2ubuntu1.1 amd64 >
#  Ubuntu Jammy qtio qhash.cpp 6.2.4
#  Ubuntu Jammy qtio qhash.cpp 6.7.2 intermittant
#  Ubuntu Noble libqt6core6t64/noble,now 6.4.2+dfsg-21.1build5 amd64>
#  SIMD (emmintrin.h / SSE2) unaligned 16-byte reads in Qt6 core hashing optimization.
#  Requires libqt6core6t64-dbgsym
   Memcheck:Addr16
   ...
   fun:*aeshash128*
   ...
}
{
   suppress_gpsbabel_parse_integer_exceptions_completely
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:*throw_*
   fun:*parse_integer*
}
{
   suppress_gpsbabel_parse_double_exceptions_completely
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:*throw_*
   fun:*parse_double*
}
{
   <Ubuntu Noble, Resolute et.al.: Qt's use of libuuc leaks.>
   Memcheck:Leak
   ...
   obj:*libicuuc*
}
