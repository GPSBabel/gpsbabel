#!/bin/bash -e
#
# package GUI application
#

function convert_qt_translations()
{
# Combine the Qt translation files we use into local qt_??.qm files.
#
# It is recommended to combine Qt's .qm files, this script does that for
# linux and macos, windeployqt does this for windows.
# https://doc.qt.io/qt-6/localization.html#deploy-translations
#
# This script is created from the log of the windows build
# with Qt 6.5.3 using windeployqt with the --verbose 2 option.
# From the log you can see which translation files are used which depends on
# which Qt modules we use.
# In our case these are qtbase_*.qm, qtdeclarative_*qm and qtserialport_*.qm,
# and qtwebengine_*.qm.
#
# Note with Qt6 the Qt distributed qt_xx.qm files are metacatalogs, and just
# copying or converting them won't copy the dependencies.

  pushd "${QT_INSTALL_TRANSLATIONS}" > /dev/null
  for language in "${LANGUAGES[@]}"
  do
    inputs=()
    inputs+=("qtbase_${language}.qm")
    if [ -e "qtdeclarative_${language}.qm" ]; then inputs+=("qtdeclarative_${language}.qm"); fi
    if [ -e "qtserialport_${language}.qm" ]; then inputs+=("qtserialport_${language}.qm"); fi
    if [ -e "qtwebengine_${language}.qm" ]; then inputs+=("qtwebengine_${language}.qm"); fi
    "${LCONVERT}" -o "${LANGDIR}/qt_${language}.qm" "${inputs[@]}"
  done
  popd > /dev/null

}

case "$(uname -s)" in
  Linux*)     machine=Linux;;
  Darwin*)    machine=Mac;;
  *)          echo "Unknown kernel name $(uname -s)." 1>&2; exit 1;;
esac

if [ "${machine}" = "Linux" ]; then
  APPDIR=GPSBabelFE
else
  APPDIR=GPSBabelFE.app
fi
GPSBABEL=../gpsbabel
QMAKE=qmake
SOURCEDIR=.
while getopts a:g:q:l:s:c:n: name
do
  case $name in
    a) APPDIR="$OPTARG";;
    g) GPSBABEL="$OPTARG";;
    q) QMAKE="$OPTARG";;
    l) IFS=';' read -r -a LANGUAGES <<< "$OPTARG";;
    s) SOURCEDIR="$OPTARG";;
    c) CODESIGN="$OPTARG";;
    n) NOTARY="$OPTARG";;
    ?) printf "Usage: %s: [-a package_directory] [-g gpsbabel] [-q qmake] [-s source_directory] [-c identity] [-n notary_keychain_profile]\n" "$0"
       exit 2;;
  esac
done
# need absolute paths for convert_qt_translations()
APPDIR="$( cd "${APPDIR}" && pwd )"

LCONVERT="$(${QMAKE} -query QT_INSTALL_BINS)/lconvert"
MACDEPLOYQT="$(${QMAKE} -query QT_INSTALL_BINS)/macdeployqt"
QT_INSTALL_TRANSLATIONS="$(${QMAKE} -query QT_INSTALL_TRANSLATIONS)"

if [ "${machine}" = "Linux" ]; then
  LANGDIR="${APPDIR}/translations"
else
  LANGDIR="${APPDIR}/Contents/Resources/translations"
fi

rm -fr "${LANGDIR}"
mkdir -p "${LANGDIR}"

# copy our compiled translations.
cp "${SOURCEDIR}"/gpsbabelfe_*.qm "${LANGDIR}"
cp "${SOURCEDIR}"/coretool/gpsbabel_*.qm "${LANGDIR}"

# bundle Qt .qm files, deploy them with our .qm files,
# and, for macos, make & deploy locversion.plist files.
(convert_qt_translations)

if [ "${machine}" = "Linux" ]; then
  cp "${GPSBABEL}" "${APPDIR}"
  cp "${SOURCEDIR}/COPYING.txt" "${APPDIR}"
else # Mac
  cp "${GPSBABEL}" "${APPDIR}/Contents/MacOS/gpsbabel"
  cp "${SOURCEDIR}/COPYING.txt" "${APPDIR}/Contents/Resources"
  cp "${SOURCEDIR}/GPSBabelFE.entitlements" "${APPDIR}/Contents/Resources"
  pushd "${APPDIR}/.."
  # macdeploytqt likes relative paths or else the dmg mount points get funky.
  APPBUNDLE="$(basename "$APPDIR")"
  VOLNAME="$(basename "$APPBUNDLE" .app)"
  DMG="${VOLNAME}.dmg"
  rm -f "${DMG}"
  set -x
  if [ -n "${CODESIGN}" ]; then
    deployopt=(-codesign="${CODESIGN}" -hardened-runtime -timestamp)
  fi
  "${MACDEPLOYQT}" "${APPBUNDLE}" -executable="${APPBUNDLE}/Contents/MacOS/gpsbabel" -verbose=2 "${deployopt[@]}"
  if [ -n "${CODESIGN}" ]; then
    if ! codesign --deep --verify "${APPBUNDLE}"; then
      # GPSBabelFE ends not being signed due incorrect signing order of gpsbabel in macdeployqt.
      # but QtCore5Compat and gpsbabel are signed belatedly.
      echo "Re-signing GPSBabelFE assuming macdeployqt failed to sign it"
      # the options we use to resign are the same as macdeployqt defaults (no hardened runtime, timestamps, extra enttilements)
      codesign --preserve-metadata=identifier,entitlements --force -s "${CODESIGN}" "${APPBUNDLE}/Contents/MacOS/GPSBabelFE" -o runtime --timestamp --entitlements "${APPBUNDLE}/Contents/Resources/GPSBabelFE.entitlements"
      codesign --deep --verify --verbose=2 "${APPBUNDLE}"
    fi
  fi
  # because we might have had to fix codesigning we have to create the dmg instead of letting macdeployqt do it.
  hdiutil create "${DMG}" -srcfolder "${APPBUNDLE}" -format UDZO -fs APFS -volname "${VOLNAME}"
  # If we are signing with a developer id and we have a notarization keychain profile notarize the dmg.
  if [ -n "${CODESIGN}" ] && \
     [ "${CODESIGN}" != "-" ] && \
     [ -n "${NOTARY}" ]; then
    xcrun notarytool submit "${DMG}" \
      --keychain-profile "${NOTARY}" \
      --wait
    xcrun stapler staple "${DMG}"
  fi
  set +x
  popd
fi
